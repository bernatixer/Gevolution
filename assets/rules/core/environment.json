{
  "schema_version": 1,
  "package_id": "core.environment",
  "version": "1.0.0",
  "label": "Standard environment: water, heat, vegetation, nutrients",
  "capabilities": [
    "core.cells.v1",
    "core.edges.v1",
    "sandbox.external_source"
  ],
  "resources": [
    {
      "id": "water",
      "unit": "kg"
    },
    {
      "id": "nutrient",
      "unit": "kg"
    },
    {
      "id": "biomass",
      "unit": "kg"
    }
  ],
  "accounts": [
    {
      "id": "external.weather",
      "resource": "water",
      "direction": "source",
      "label": "Prescribed rainfall (open weather boundary)"
    },
    {
      "id": "external.atmosphere",
      "resource": "water",
      "direction": "sink",
      "label": "Evaporation to the untracked atmosphere"
    },
    {
      "id": "external.transpiration",
      "resource": "water",
      "direction": "sink",
      "label": "Water transpired by plants"
    },
    {
      "id": "external.photosynthesis",
      "resource": "biomass",
      "direction": "source",
      "label": "Biomass fixed by plant growth (toy exchange)"
    },
    {
      "id": "external.respiration",
      "resource": "biomass",
      "direction": "sink",
      "label": "Detritus respired by decomposers (toy exchange)"
    }
  ],
  "fields": [
    {
      "id": "elevation",
      "unit": "m",
      "policy": {
        "kind": "parameter"
      },
      "label": "Terrain elevation"
    },
    {
      "id": "temperature",
      "unit": "K",
      "policy": {
        "kind": "integrated"
      },
      "default": 288.0,
      "min": 220.0,
      "max": 340.0,
      "label": "Surface temperature"
    },
    {
      "id": "surface_water",
      "unit": "kg",
      "policy": {
        "kind": "reservoir",
        "resource": "water"
      },
      "label": "Surface water"
    },
    {
      "id": "soil_water_capacity",
      "unit": "kg",
      "policy": {
        "kind": "parameter"
      },
      "default": 3000.0,
      "label": "Soil water capacity"
    },
    {
      "id": "soil_water",
      "unit": "kg",
      "policy": {
        "kind": "reservoir",
        "resource": "water",
        "capacity": "soil_water_capacity"
      },
      "label": "Soil water"
    },
    {
      "id": "groundwater",
      "unit": "kg",
      "policy": {
        "kind": "reservoir",
        "resource": "water"
      },
      "label": "Groundwater"
    },
    {
      "id": "conductance_factor",
      "unit": "1",
      "policy": {
        "kind": "parameter"
      },
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "label": "Surface permeability to flow (0 = impermeable)"
    },
    {
      "id": "vegetation_biomass",
      "unit": "kg",
      "policy": {
        "kind": "reservoir",
        "resource": "biomass"
      },
      "label": "Vegetation biomass"
    },
    {
      "id": "plant_nutrients",
      "unit": "kg",
      "policy": {
        "kind": "reservoir",
        "resource": "nutrient"
      },
      "label": "Nutrients in living plants"
    },
    {
      "id": "soil_nutrients",
      "unit": "kg",
      "policy": {
        "kind": "reservoir",
        "resource": "nutrient"
      },
      "label": "Available soil nutrients"
    },
    {
      "id": "detritus_biomass",
      "unit": "kg",
      "policy": {
        "kind": "reservoir",
        "resource": "biomass"
      },
      "label": "Dead organic material"
    },
    {
      "id": "detritus_nutrients",
      "unit": "kg",
      "policy": {
        "kind": "reservoir",
        "resource": "nutrient"
      },
      "label": "Nutrients in detritus"
    }
  ],
  "forcings": [
    {
      "id": "rain_flux",
      "unit": "kg/(m^2*s)",
      "quantity": "water",
      "domain": "cells",
      "label": "Rainfall mass flux"
    },
    {
      "id": "ambient_temperature",
      "unit": "K",
      "domain": "cells",
      "label": "Ambient air temperature"
    },
    {
      "id": "relative_humidity",
      "unit": "1",
      "domain": "uniform",
      "label": "Relative humidity"
    }
  ],
  "parameters": {
    "water_density": {
      "value": 1000.0,
      "unit": "kg/m^3",
      "min": 500.0,
      "max": 2000.0,
      "label": "Water density (toy constant)"
    },
    "reference_temperature": {
      "value": 288.0,
      "unit": "K",
      "min": 250.0,
      "max": 320.0,
      "label": "Reference temperature"
    },
    "vegetation_half_cover": {
      "value": 400.0,
      "unit": "kg",
      "min": 1.0,
      "max": 100000.0,
      "label": "Biomass giving 50% cover"
    }
  },
  "rules": [
    {
      "rule_id": "core.env.rain",
      "label": "Rainfall",
      "template": "rainfall",
      "domain": {
        "kind": "cells"
      },
      "parameters": {
        "rain_factor": {
          "value": 1.0,
          "unit": "1",
          "min": 0.0,
          "max": 5.0,
          "label": "Global rainfall multiplier"
        }
      },
      "nodes": [
        {
          "id": "flux",
          "op": "read_forcing",
          "forcing": "rain_flux"
        },
        {
          "id": "area",
          "op": "cell_area"
        },
        {
          "id": "factor",
          "op": "parameter",
          "name": "rain_factor"
        },
        {
          "id": "per_cell",
          "op": "mul",
          "inputs": [
            "flux",
            "area"
          ]
        },
        {
          "id": "rate",
          "op": "mul",
          "inputs": [
            "per_cell",
            "factor"
          ]
        },
        {
          "id": "rain",
          "op": "external_source",
          "resource": "water",
          "account": "external.weather",
          "to": "surface_water",
          "rate": "rate"
        }
      ],
      "effects": [
        "rain"
      ]
    },
    {
      "rule_id": "core.env.evaporation",
      "label": "Surface evaporation",
      "template": "evaporation",
      "domain": {
        "kind": "cells"
      },
      "parameters": {
        "potential_evaporation": {
          "value": 0.0015,
          "unit": "kg/(m^2*s)",
          "min": 0.0,
          "max": 0.1,
          "label": "Potential evaporation flux at reference conditions"
        },
        "wet_film": {
          "value": 0.005,
          "unit": "m",
          "min": 0.0001,
          "max": 1.0,
          "label": "Water depth that fully wets a cell"
        },
        "beta": {
          "value": 0.05,
          "unit": "1/dK",
          "min": 0.0,
          "max": 0.5,
          "label": "Temperature sensitivity"
        }
      },
      "nodes": [
        {
          "id": "water",
          "op": "read_state",
          "field": "surface_water"
        },
        {
          "id": "t",
          "op": "read_state",
          "field": "temperature"
        },
        {
          "id": "t_ref",
          "op": "parameter",
          "name": "reference_temperature"
        },
        {
          "id": "dt",
          "op": "sub",
          "inputs": [
            "t",
            "t_ref"
          ]
        },
        {
          "id": "beta",
          "op": "parameter",
          "name": "beta"
        },
        {
          "id": "bdt",
          "op": "mul",
          "inputs": [
            "beta",
            "dt"
          ]
        },
        {
          "id": "one",
          "op": "const",
          "value": 1.0,
          "unit": "1"
        },
        {
          "id": "zero",
          "op": "const",
          "value": 0.0,
          "unit": "1"
        },
        {
          "id": "three",
          "op": "const",
          "value": 3.0,
          "unit": "1"
        },
        {
          "id": "tf_raw",
          "op": "add",
          "inputs": [
            "one",
            "bdt"
          ]
        },
        {
          "id": "temperature_factor",
          "op": "clamp",
          "inputs": [
            "tf_raw",
            "zero",
            "three"
          ]
        },
        {
          "id": "rh",
          "op": "read_forcing",
          "forcing": "relative_humidity"
        },
        {
          "id": "dry_raw",
          "op": "sub",
          "inputs": [
            "one",
            "rh"
          ]
        },
        {
          "id": "dryness_factor",
          "op": "clamp",
          "inputs": [
            "dry_raw",
            "zero",
            "one"
          ]
        },
        {
          "id": "rho",
          "op": "parameter",
          "name": "water_density"
        },
        {
          "id": "area",
          "op": "cell_area"
        },
        {
          "id": "film",
          "op": "parameter",
          "name": "wet_film"
        },
        {
          "id": "rho_area",
          "op": "mul",
          "inputs": [
            "rho",
            "area"
          ]
        },
        {
          "id": "film_mass",
          "op": "mul",
          "inputs": [
            "rho_area",
            "film"
          ]
        },
        {
          "id": "wet_raw",
          "op": "safe_divide",
          "inputs": [
            "water",
            "film_mass",
            "zero"
          ]
        },
        {
          "id": "wet",
          "op": "clamp",
          "inputs": [
            "wet_raw",
            "zero",
            "one"
          ]
        },
        {
          "id": "e0",
          "op": "parameter",
          "name": "potential_evaporation"
        },
        {
          "id": "e_cell",
          "op": "mul",
          "inputs": [
            "e0",
            "area"
          ]
        },
        {
          "id": "e1",
          "op": "mul",
          "inputs": [
            "e_cell",
            "temperature_factor"
          ]
        },
        {
          "id": "e2",
          "op": "mul",
          "inputs": [
            "e1",
            "dryness_factor"
          ]
        },
        {
          "id": "rate",
          "op": "mul",
          "inputs": [
            "e2",
            "wet"
          ]
        },
        {
          "id": "evaporate",
          "op": "external_sink",
          "resource": "water",
          "from": "surface_water",
          "account": "external.atmosphere",
          "rate": "rate"
        }
      ],
      "effects": [
        "evaporate"
      ]
    },
    {
      "rule_id": "core.env.soil_evaporation",
      "label": "Soil evaporation (reduced under vegetation)",
      "template": "evaporation",
      "domain": {
        "kind": "cells"
      },
      "parameters": {
        "soil_evaporation": {
          "value": 0.0006,
          "unit": "kg/(m^2*s)",
          "min": 0.0,
          "max": 0.1,
          "label": "Potential soil evaporation flux"
        },
        "shade": {
          "value": 0.7,
          "unit": "1",
          "min": 0.0,
          "max": 1.0,
          "label": "Shading by full cover"
        }
      },
      "nodes": [
        {
          "id": "tf",
          "op": "mul",
          "inputs": [
            "core.env.evaporation/temperature_factor",
            "core.env.evaporation/dryness_factor"
          ]
        },
        {
          "id": "cover",
          "op": "sub",
          "inputs": [
            "core.env.temperature/one",
            "core.env.temperature/bare"
          ]
        },
        {
          "id": "shade",
          "op": "parameter",
          "name": "shade"
        },
        {
          "id": "shaded",
          "op": "mul",
          "inputs": [
            "shade",
            "cover"
          ]
        },
        {
          "id": "open",
          "op": "sub",
          "inputs": [
            "core.env.temperature/one",
            "shaded"
          ]
        },
        {
          "id": "e0",
          "op": "parameter",
          "name": "soil_evaporation"
        },
        {
          "id": "area",
          "op": "cell_area"
        },
        {
          "id": "e_cell",
          "op": "mul",
          "inputs": [
            "e0",
            "area"
          ]
        },
        {
          "id": "e1",
          "op": "mul",
          "inputs": [
            "e_cell",
            "tf"
          ]
        },
        {
          "id": "e2",
          "op": "mul",
          "inputs": [
            "e1",
            "open"
          ]
        },
        {
          "id": "rate",
          "op": "mul",
          "inputs": [
            "e2",
            "core.env.temperature/moisture"
          ]
        },
        {
          "id": "evaporate",
          "op": "external_sink",
          "resource": "water",
          "from": "soil_water",
          "account": "external.atmosphere",
          "rate": "rate"
        }
      ],
      "effects": [
        "evaporate"
      ]
    },
    {
      "rule_id": "core.env.flow",
      "label": "Head-driven surface flow (sheet flow slowed quadratically below the reference depth)",
      "template": "flow",
      "domain": {
        "kind": "edges"
      },
      "parameters": {
        "conductance": {
          "value": 5000.0,
          "unit": "kg/(m*s)",
          "min": 0.0,
          "max": 50000.0,
          "label": "Hydraulic conductance",
          "stability": {
            "kind": "transport",
            "density_param": "water_density",
            "limit": 0.5
          }
        },
        "reference_depth": {
          "value": 0.05,
          "unit": "m",
          "min": 0.0001,
          "max": 10.0,
          "label": "Upwind depth for full conductance"
        }
      },
      "nodes": [
        {
          "id": "elevation",
          "op": "read_state",
          "field": "elevation"
        },
        {
          "id": "water",
          "op": "read_state",
          "field": "surface_water"
        },
        {
          "id": "rho",
          "op": "parameter",
          "name": "water_density"
        },
        {
          "id": "area",
          "op": "cell_area"
        },
        {
          "id": "rho_area",
          "op": "mul",
          "inputs": [
            "rho",
            "area"
          ]
        },
        {
          "id": "zero_m",
          "op": "const",
          "value": 0.0,
          "unit": "m"
        },
        {
          "id": "depth",
          "op": "safe_divide",
          "inputs": [
            "water",
            "rho_area",
            "zero_m"
          ]
        },
        {
          "id": "head",
          "op": "add",
          "inputs": [
            "elevation",
            "depth"
          ]
        },
        {
          "id": "head_from",
          "op": "edge_from",
          "inputs": [
            "head"
          ]
        },
        {
          "id": "head_to",
          "op": "edge_to",
          "inputs": [
            "head"
          ]
        },
        {
          "id": "dh",
          "op": "sub",
          "inputs": [
            "head_from",
            "head_to"
          ]
        },
        {
          "id": "perm",
          "op": "read_state",
          "field": "conductance_factor"
        },
        {
          "id": "perm_from",
          "op": "edge_from",
          "inputs": [
            "perm"
          ]
        },
        {
          "id": "perm_to",
          "op": "edge_to",
          "inputs": [
            "perm"
          ]
        },
        {
          "id": "perm_edge",
          "op": "min",
          "inputs": [
            "perm_from",
            "perm_to"
          ]
        },
        {
          "id": "c",
          "op": "parameter",
          "name": "conductance"
        },
        {
          "id": "c_edge",
          "op": "mul",
          "inputs": [
            "c",
            "perm_edge"
          ]
        },
        {
          "id": "depth_from",
          "op": "edge_from",
          "inputs": [
            "depth"
          ]
        },
        {
          "id": "depth_to",
          "op": "edge_to",
          "inputs": [
            "depth"
          ]
        },
        {
          "id": "downhill",
          "op": "gt",
          "inputs": [
            "dh",
            "zero_m"
          ]
        },
        {
          "id": "upwind_depth",
          "op": "select",
          "inputs": [
            "downhill",
            "depth_from",
            "depth_to"
          ]
        },
        {
          "id": "ref",
          "op": "parameter",
          "name": "reference_depth"
        },
        {
          "id": "zero",
          "op": "const",
          "value": 0.0,
          "unit": "1"
        },
        {
          "id": "one",
          "op": "const",
          "value": 1.0,
          "unit": "1"
        },
        {
          "id": "depth_ratio",
          "op": "safe_divide",
          "inputs": [
            "upwind_depth",
            "ref",
            "zero"
          ]
        },
        {
          "id": "depth_linear",
          "op": "clamp",
          "inputs": [
            "depth_ratio",
            "zero",
            "one"
          ]
        },
        {
          "id": "depth_factor",
          "op": "mul",
          "inputs": [
            "depth_linear",
            "depth_linear"
          ]
        },
        {
          "id": "c_depth",
          "op": "mul",
          "inputs": [
            "c_edge",
            "depth_factor"
          ]
        },
        {
          "id": "rate",
          "op": "mul",
          "inputs": [
            "c_depth",
            "dh"
          ]
        },
        {
          "id": "flow",
          "op": "edge_transfer",
          "resource": "water",
          "field": "surface_water",
          "rate": "rate"
        }
      ],
      "effects": [
        "flow"
      ]
    },
    {
      "rule_id": "core.env.infiltration",
      "label": "Infiltration into soil",
      "domain": {
        "kind": "cells"
      },
      "parameters": {
        "k_infiltration": {
          "value": 0.01,
          "unit": "1/s",
          "min": 0.0,
          "max": 1.0,
          "label": "Infiltration coefficient",
          "stability": {
            "kind": "first_order"
          }
        }
      },
      "nodes": [
        {
          "id": "water",
          "op": "read_state",
          "field": "surface_water"
        },
        {
          "id": "k",
          "op": "parameter",
          "name": "k_infiltration"
        },
        {
          "id": "rate",
          "op": "mul",
          "inputs": [
            "k",
            "water"
          ]
        },
        {
          "id": "infiltrate",
          "op": "transfer",
          "resource": "water",
          "from": "surface_water",
          "to": "soil_water",
          "rate": "rate"
        }
      ],
      "effects": [
        "infiltrate"
      ]
    },
    {
      "rule_id": "core.env.groundwater",
      "label": "Drainage to groundwater and spring release",
      "domain": {
        "kind": "cells"
      },
      "parameters": {
        "k_drainage": {
          "value": 0.0005,
          "unit": "1/s",
          "min": 0.0,
          "max": 1.0,
          "label": "Drainage coefficient",
          "stability": {
            "kind": "first_order"
          }
        },
        "retention": {
          "value": 0.5,
          "unit": "1",
          "min": 0.0,
          "max": 1.0,
          "label": "Retained fraction of soil capacity"
        },
        "k_spring": {
          "value": 0.0002,
          "unit": "1/s",
          "min": 0.0,
          "max": 1.0,
          "label": "Spring release coefficient",
          "stability": {
            "kind": "first_order"
          }
        },
        "spring_threshold": {
          "value": 2000.0,
          "unit": "kg",
          "min": 0.0,
          "max": 1000000.0,
          "label": "Groundwater held back from springs"
        }
      },
      "nodes": [
        {
          "id": "soil",
          "op": "read_state",
          "field": "soil_water"
        },
        {
          "id": "cap",
          "op": "read_state",
          "field": "soil_water_capacity"
        },
        {
          "id": "retention",
          "op": "parameter",
          "name": "retention"
        },
        {
          "id": "held",
          "op": "mul",
          "inputs": [
            "cap",
            "retention"
          ]
        },
        {
          "id": "excess_raw",
          "op": "sub",
          "inputs": [
            "soil",
            "held"
          ]
        },
        {
          "id": "zero_kg",
          "op": "const",
          "value": 0.0,
          "unit": "kg"
        },
        {
          "id": "excess",
          "op": "max",
          "inputs": [
            "excess_raw",
            "zero_kg"
          ]
        },
        {
          "id": "kd",
          "op": "parameter",
          "name": "k_drainage"
        },
        {
          "id": "drain_rate",
          "op": "mul",
          "inputs": [
            "kd",
            "excess"
          ]
        },
        {
          "id": "drain",
          "op": "transfer",
          "resource": "water",
          "from": "soil_water",
          "to": "groundwater",
          "rate": "drain_rate"
        },
        {
          "id": "gw",
          "op": "read_state",
          "field": "groundwater"
        },
        {
          "id": "threshold",
          "op": "parameter",
          "name": "spring_threshold"
        },
        {
          "id": "gw_excess_raw",
          "op": "sub",
          "inputs": [
            "gw",
            "threshold"
          ]
        },
        {
          "id": "gw_excess",
          "op": "max",
          "inputs": [
            "gw_excess_raw",
            "zero_kg"
          ]
        },
        {
          "id": "ks",
          "op": "parameter",
          "name": "k_spring"
        },
        {
          "id": "spring_rate",
          "op": "mul",
          "inputs": [
            "ks",
            "gw_excess"
          ]
        },
        {
          "id": "spring",
          "op": "transfer",
          "resource": "water",
          "from": "groundwater",
          "to": "surface_water",
          "rate": "spring_rate"
        }
      ],
      "effects": [
        "drain",
        "spring"
      ]
    },
    {
      "rule_id": "core.env.temperature",
      "label": "Forced temperature relaxation, diffusion, and shaded heating",
      "domain": {
        "kind": "cells"
      },
      "parameters": {
